{
  "name": "clubpulse-live",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build:react": "npm --prefix react-app install && npm --prefix react-app run build && rm -rf public/react && mkdir -p public/react && cp -R react-app/dist/. public/react/",
    "build": "npm test && npm run build:react && next build",
    "start": "next start -p 10000",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "pg": "^8.16.3",
    "bcryptjs": "^3.0.2",
    "zod": "^4.1.12",
    "lucide-react": "^0.468.0",
    "google-auth-library": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  }
}