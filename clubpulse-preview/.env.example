# Use a Neon Free PostgreSQL connection string. Keep secrets out of GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional, only if using a provider that needs explicit pg SSL configuration
# PGSSL=true
NEXT_PUBLIC_APP_URL=http://localhost:3000


# Google Identity Services: create a Web OAuth client and add the public site origin.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional first-administrator provisioning: use a random secret with 32+ characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_SECRET=replace-with-random-secret-at-least-32-characters
NEXT_PUBLIC_BOOTSTRAP_ADMIN_ENABLED=false
VITE_BOOTSTRAP_ADMIN_ENABLED=false
