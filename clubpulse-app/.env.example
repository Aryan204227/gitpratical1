# ─── MongoDB Configuration ───────────────────────────────────────────────────
# MongoDB connection string for ClubPulse V2 (must connect to database clubpulse_v2)
MONGODB_URI=mongodb://localhost:27017/clubpulse_v2

# ─── Firebase Authentication ───────────────────────────────────────────────────
# Firebase Web Client SDK Configuration for authentication and Google sign-in
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Server-only Firebase Admin service account JSON. Keep this secret out of Git.
# Store the full JSON as one environment variable; escape private_key newlines as \\n.
FIREBASE_SERVICE_ACCOUNT_JSON=
