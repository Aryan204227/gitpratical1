# ─── Session Security ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# ─── MongoDB Configuration ───────────────────────────────────────────────────
# MongoDB connection string for ClubPulse V2 (must connect to database clubpulse_v2)
MONGODB_URI=mongodb://localhost:27017/clubpulse_v2

# ─── Firebase Authentication ───────────────────────────────────────────────────
# Firebase Web Client SDK Configuration for authentication and Google sign-in
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ─── Admin Authorization ───────────────────────────────────────────────────────
# Comma-separated list of campus emails granted automatic Dean / Admin privileges
ADMIN_EMAILS=

# Optional direct Google Identity Services endpoint (only if that login route is used)
GOOGLE_CLIENT_ID=
